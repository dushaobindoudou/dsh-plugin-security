{
  "name": "dsh-plugin-security",
  "version": "0.5.0",
  "description": "Plugin security review for DeepSeek Harness: dependency advisories, contextual static evidence, a call-time gate for high-risk plugins, and reversible review-gated enforcement.",
  "type": "module",
  "license": "MIT",
  "author": "dushaobindoudou",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./scan": "./lib/scan.js",
    "./screen": "./lib/screen.js",
    "./audit": "./lib/audit.js",
    "./state": "./lib/state.js",
    "./disposition": "./lib/disposition.js",
    "./risk": "./lib/risk.js",
    "./gate": "./lib/gate.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "skills/**/SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node e2e/run.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "audit",
    "cordis-plugin",
    "deepseek-harness",
    "dsh-plugin",
    "malware-screening",
    "npm-audit",
    "plugin-security",
    "security",
    "supply-chain-security",
    "tool-call-gate",
    "vulnerability"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "acorn": "8.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/dsh-plugin-security.git"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-plugin-security#readme",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-plugin-security/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.28.0",
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.3.0"
  }
}
