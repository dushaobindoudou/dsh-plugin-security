{
  "name": "dsh-plugin-security",
  "version": "0.1.0",
  "description": "Supply-chain security gate for DeepSeek Harness: audit any npm plugin before you install it, and diff what an update changes — new install scripts, credential access, network hosts, subprocess or dynamic execution, with file:line evidence.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./scanner": "./lib/scanner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node test/smoke.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "security",
    "supply-chain",
    "npm-audit",
    "plugin-security",
    "install-gate",
    "version-diff"
  ],
  "author": "dushaobindoudou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/dsh-plugin-security.git"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-plugin-security#readme",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-plugin-security/issues"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
